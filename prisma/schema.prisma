generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MAINXP — an AI life OS wrapped inside a real-life RPG.
// Totals (XP, streaks) are always derived from ledger/log rows, never stored
// as standalone truth. See docs/DATABASE_SCHEMA.md and docs/XP_SYSTEM.md.
// ─────────────────────────────────────────────────────────────────────────────

enum MxAttribute {
  STRENGTH
  ENDURANCE
  FOCUS
  DISCIPLINE
  KNOWLEDGE
  STRATEGY
  WEALTH
  MIND
  SOCIAL
}

enum MxGoalHorizon {
  LIFETIME
  THREE_YEAR
  ONE_YEAR
  NINETY_DAY
  MONTHLY
  WEEKLY
}

enum MxGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum MxProjectStatus {
  IDEA
  PLANNING
  ACTIVE
  WAITING
  BLOCKED
  AT_RISK
  PAUSED
  COMPLETED
  CANCELLED
}

enum MxTaskTier {
  MAIN_QUEST
  DAILY_MISSION
  SIDE_QUEST
  BACKLOG
}

enum MxTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum MxCadence {
  DAILY
  WEEKLY
}

// Evidence level of a recorded action (anti-farming / future leaderboards).
// Never used to accuse — only to weight rare achievements and rankings.
enum MxEvidence {
  SELF_REPORTED // user says it happened (manual completions)
  SYSTEM_RECORDED // MAINXP measured it (server-timed focus sessions)
  VERIFIED // confirmed by an integrated external source (Phase 3+)
}

model MxUser {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  timezone         String   @default("Europe/Zurich") // IANA; defines the user's "day"
  locale           String   @default("fr")
  onboardingStage  String   @default("new") // new | bio_done
  occupation       String   @default("")
  coachTone        String   @default("balanced") // concise|detailed × soft|demanding presets
  notificationMode String   @default("normal") // quiet | normal | coach_me | beast
  quietHoursStart  Int? // hour 0-23, user timezone
  quietHoursEnd    Int?
  restMode         Boolean  @default(false) // "Récupération" — pauses élan decay, never punishes rest
  aiKey            String? // personal AI provider key (server-side only, set in-app; overrides env)
  notifDailyCap    Int? // null = the mode's default
  lastSeenAt       DateTime? // "is the user in the app right now?" — suppresses pushes
  pushEnabledAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions          MxSession[]
  northStar         MxNorthStar?
  goals             MxGoal[]
  projects          MxProject[]
  tasks             MxTask[]
  nonNegotiables    MxNonNegotiable[]
  nonNegotiableLogs MxNonNegotiableLog[]
  habits            MxHabit[]
  habitLogs         MxHabitLog[]
  dayPlans          MxDayPlan[]
  focusSessions     MxFocusSession[]
  xpTransactions    MxXpTransaction[]
  journalEntries    MxJournalEntry[]
  gratitudeEntries  MxGratitudeEntry[]
  memories          MxMemory[]
  conversations     MxConversation[]
  rewards           MxReward[]
  gearOwned         MxGearOwned[]
  events            MxEvent[]
  routineItems      MxRoutineItem[]
  routineLogs       MxRoutineLog[]
  challenges        MxChallenge[]
  challengeLogs     MxChallengeLog[]
  books             MxBook[]
  pushSubs          MxPushSubscription[]
  notifications     MxNotification[]

  invitesSent     MxCircleInvite[]  @relation("MxInvitesSent")
  invitesAccepted MxCircleInvite[]  @relation("MxInvitesAccepted")
  circleShares    MxCircleLink[]    @relation("MxCircleOwner") // what I show
  circleReceives  MxCircleLink[]    @relation("MxCirclePartner") // what I am shown
  blocksMade      MxBlock[]         @relation("MxBlocksMade")
  blocksReceived  MxBlock[]         @relation("MxBlocksReceived")
  supportSent     MxEncouragement[] @relation("MxSupportSent")
  supportReceived MxEncouragement[] @relation("MxSupportReceived")
  passwordResets  MxPasswordReset[]

  @@map("mainxp_users")
}

// ── Web Push (PWA): one row per installed device that granted permission.
// Endpoints expire; a 404/410 from the push service retires the row.
model MxPushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique // re-subscribe upserts, never duplicates
  p256dh        String
  auth          String
  platform      String    @default("")
  userAgent     String    @default("")
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  disabledAt    DateTime? // 410/404 → soft-disable, keep for audit
  createdAt     DateTime  @default(now())

  @@index([userId, disabledAt])
  @@map("mainxp_push_subscriptions")
}

// ── Delivery record: what was sent, why, and what the user did with it.
// This is what lets MAINXP learn which notifications actually help — and
// stay silent when they don't (MASTER_1M_PROMPT §7).
model MxNotification {
  id               String    @id @default(cuid())
  userId           String
  user             MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // main_quest_stale | commitment_open | night_review | goal_pace_behind | challenge_tick
  dayKey           String // user-timezone day
  /** "<userId>:<type>:<dayKey>[:<targetId>]" — the ONLY thing preventing double sends. */
  dedupeKey        String    @unique
  title            String
  body             String
  url              String    @default("/today")
  mode             String // notificationMode at decision time
  urgency          Int       @default(0)
  status           String    @default("QUEUED") // QUEUED | SENT | SUPPRESSED | FAILED
  /** quiet_hours | daily_cap | min_gap | in_app | mode | rest_mode | no_subscription | not_relevant | resolved — silence is a RECORDED decision, never an absence of data. */
  suppressedReason String?
  evidence         Json      @default("{}") // the numbers that justified the copy
  sentAt           DateTime?
  openedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, dayKey])
  @@index([userId, type, createdAt])
  @@map("mainxp_notifications")
}

// ── Library (audit P9): books with the user's own writing — what it taught,
// what gets APPLIED. Adding a book is organizing (0 XP); FINISHING one is a
// real accomplishment (Knowledge XP, discovered, never advertised).
model MxBook {
  id         String    @id @default(cuid())
  userId     String
  user       MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  author     String    @default("")
  status     String    @default("reading") // to_read | reading | finished | abandoned
  notes      String    @default("") // ce que j'en retiens — écrit en lisant
  lessons    String    @default("") // ce que j'APPLIQUE — la leçon en action
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@map("mainxp_books")
}

// ── Challenges (audit #24): time-boxed dares — « Glen, tu acceptes ? » —
// proposed by the coach (or picked from starters), accepted explicitly,
// ticked day by day. Ticks are structure (0 XP); COMPLETION is the surprise
// reward, scaled by duration. Never more than a few alive at once.
model MxChallenge {
  id           String    @id @default(cuid())
  userId       String
  user         MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String    @default("") // the dare, in words — why it's worth it
  durationDays Int // window to finish, from acceptance
  targetCount  Int // ticks needed (30 meditation days, 1 book…)
  unitLabel    String    @default("jours")
  status       String    @default("proposed") // proposed|active|completed|declined|abandoned
  source       String    @default("coach") // coach|starter|self
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  logs MxChallengeLog[]

  @@index([userId, status])
  @@map("mainxp_challenges")
}

model MxChallengeLog {
  id          String      @id @default(cuid())
  userId      String
  user        MxUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   MxChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dayKey      String

  @@unique([challengeId, dayKey])
  @@map("mainxp_challenge_logs")
}

// ── Routines (audit P9, first slice): the morning ritual — structure you walk
// through, distinct from habits. Ticking a routine item is structure, not
// merit: it never awards XP (the Morning Start event carries the day's XP,
// once). The `note` is the user's own writing: why it matters, how it's done.
model MxRoutineItem {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  note      String   @default("") // free writing — le pourquoi / le comment
  timeOfDay String   @default("morning") // morning | evening (later)
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  logs MxRoutineLog[]

  @@index([userId, active])
  @@map("mainxp_routine_items")
}

model MxRoutineLog {
  id            String        @id @default(cuid())
  userId        String
  user          MxUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineItemId String
  item          MxRoutineItem @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
  dayKey        String // "YYYY-MM-DD" user timezone
  done          Boolean       @default(true)
  /** This morning's note on this step — distinct from the item's definition. */
  note          String        @default("")

  @@unique([routineItemId, dayKey])
  @@index([userId, dayKey])
  @@map("mainxp_routine_logs")
}

// SYSTEM OF RECORD (docs/ARCHITECTURE.md): every meaningful real-life action
// creates exactly one event; XP, streaks, titles, stats derive from it.
model MxEvent {
  id             String     @id @default(cuid())
  userId         String
  user           MxUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // task_completed | main_quest_completed | habit_completed | commitment_kept | focus_completed | goal_reached | …
  payload        Json       @default("{}")
  evidence       MxEvidence @default(SELF_REPORTED)
  dayKey         String // user-timezone day the action belongs to
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())

  @@index([userId, type])
  @@index([userId, dayKey])
  @@map("mainxp_events")
}

model MxSession {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 of the cookie token — plaintext never stored
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("mainxp_sessions")
}

model MxNorthStar {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  why             String   @default("")
  values          Json     @default("[]")
  futureSelf      String   @default("")
  vision1Year     String   @default("")
  mission90Days   String   @default("")
  season          String   @default("") // e.g. "Revenue Season"
  /** Self-concept: the story told about oneself, written in the present tense. */
  selfConcept     String   @default("")
  /** 1–10: how TRUE the self-concept FEELS when read — mind/heart alignment. */
  identityFelt    Int?
  priorities      Json     @default("[]")
  personalRules   Json     @default("[]")
  importantPeople Json     @default("[]")
  refusals        String   @default("") // "what I refuse to become"
  updatedAt       DateTime @updatedAt

  @@map("mainxp_north_stars")
}

model MxGoal {
  id           String        @id @default(cuid())
  userId       String
  user         MxUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String        @default("")
  why          String        @default("")
  lifeArea     String        @default("") // body|purpose|progress|people|mind|character|money|…
  horizon      MxGoalHorizon @default(NINETY_DAY)
  targetValue  Float?
  currentValue Float         @default(0)
  unit         String?
  deadline     DateTime?
  priority     Int           @default(3) // 1 (top) – 5
  status       MxGoalStatus  @default(ACTIVE)
  reward       String? // user-defined real-life reward
  createdAt    DateTime      @default(now())
  completedAt  DateTime?

  projects       MxProject[]
  tasks          MxTask[]
  nonNegotiables MxNonNegotiable[]
  habits         MxHabit[]
  focusSessions  MxFocusSession[]

  @@index([userId, status])
  @@map("mainxp_goals")
}

model MxProject {
  id             String          @id @default(cuid())
  userId         String
  user           MxUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId         String?
  goal           MxGoal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title          String
  desiredOutcome String          @default("")
  why            String          @default("")
  priority       Int             @default(3)
  deadline       DateTime?
  status         MxProjectStatus @default(PLANNING)
  progress       Int             @default(0) // 0-100, derived from milestones when present
  nextAction     String          @default("") // every active project must name one
  blockers       String          @default("")
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  milestones MxMilestone[]
  tasks      MxTask[]

  @@index([userId, status])
  @@map("mainxp_projects")
}

model MxMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     MxProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  order       Int       @default(0)
  done        Boolean   @default(false)
  completedAt DateTime?

  @@index([projectId])
  @@map("mainxp_milestones")
}

model MxTask {
  id            String       @id @default(cuid())
  userId        String
  user          MxUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String?
  goal          MxGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId     String?
  project       MxProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  notes         String       @default("")
  tier          MxTaskTier   @default(DAILY_MISSION)
  status        MxTaskStatus @default(OPEN)
  dayKey        String? // "YYYY-MM-DD" in the user's timezone; null = backlog
  order         Int          @default(0)
  estimateMin   Int?
  postponeCount Int          @default(0) // feeds hard-mode XP + anti-drift
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  focusSessions MxFocusSession[]

  @@index([userId, dayKey])
  @@index([userId, status])
  @@map("mainxp_tasks")
}

model MxNonNegotiable {
  id        String    @id @default(cuid())
  userId    String
  user      MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String?
  goal      MxGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title     String
  cadence   MxCadence @default(DAILY)
  target    Float     @default(1)
  unit      String? // calls, pages, workouts…
  minimum   Float? // smallest acceptable version
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  logs MxNonNegotiableLog[]

  @@index([userId, active])
  @@map("mainxp_non_negotiables")
}

model MxNonNegotiableLog {
  id              String          @id @default(cuid())
  userId          String
  user            MxUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nonNegotiableId String
  nonNegotiable   MxNonNegotiable @relation(fields: [nonNegotiableId], references: [id], onDelete: Cascade)
  periodKey       String // dayKey (daily) or weekKey (weekly)
  value           Float           @default(0)
  completed       Boolean         @default(false)
  /** What it cost, or what made it easy, today. */
  note            String          @default("")
  updatedAt       DateTime        @updatedAt

  @@unique([nonNegotiableId, periodKey])
  @@index([userId, periodKey])
  @@map("mainxp_non_negotiable_logs")
}

model MxHabit {
  id        String       @id @default(cuid())
  userId    String
  user      MxUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String?
  goal      MxGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title       String
  description String       @default("") // the user's own words: pourquoi / comment
  kind        String       @default("good") // good (tap = XP) | bad (tap = élan hit, zero XP)
  category  String       @default("") // body|money|mind|people|business|learning
  attribute MxAttribute? // which attribute logging feeds
  cadence   MxCadence    @default(DAILY)
  target    Float        @default(1)
  unit      String?
  minimum   Float?
  reminder  String? // "HH:MM" user timezone
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  logs MxHabitLog[]

  @@index([userId, active])
  @@map("mainxp_habits")
}

model MxHabitLog {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String
  habit     MxHabit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  periodKey String // dayKey or weekKey per cadence
  value     Float    @default(1)
  /** How it actually went, in the user's words. Written at the moment of doing. */
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([habitId, periodKey])
  @@index([userId, periodKey])
  @@map("mainxp_habit_logs")
}

model MxDayPlan {
  id     String @id @default(cuid())
  userId String
  user   MxUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey String // "YYYY-MM-DD" user timezone

  // Morning check-in (Part 12)
  mood      Int? // 1-10
  energy    Int?
  stress    Int?
  focus     Int?
  morningIntention String @default("") // free morning writing — intention, pensées
  startedAt DateTime? // morning flow completed

  // Minimum Day (addendum #7): protect the essentials on a bad day
  minimumDay      Boolean @default(false)
  minBodyDone     Boolean @default(false)
  minProgressDone Boolean @default(false)
  minMindDone     Boolean @default(false)

  // Night review (Part 31)
  reviewedAt       DateTime?
  reviewWentWell   String    @default("")
  reviewMissedWhy  String    @default("")
  reviewLesson     String    @default("")
  reviewFeelings   String    @default("") // qu'as-tu RESSENTI — l'émotion du jour
  reviewAlignment  String    @default("") // la journée t'a-t-elle rapproché de ta mission ?
  tomorrowBigThing String    @default("")
  preparedAt       DateTime? // tomorrow draft generated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayKey])
  @@map("mainxp_day_plans")
}

model MxFocusSession {
  id            String    @id @default(cuid())
  userId        String
  user          MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          MxTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goalId        String?
  goal          MxGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  plannedMin    Int // 25 | 50 | 90 | custom
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  interruptions Int       @default(0)
  completed     Boolean   @default(false)
  notes         String    @default("")

  @@index([userId, startedAt])
  @@map("mainxp_focus_sessions")
}

// Append-only XP ledger — the single source of truth for all progression.
// Rows are never updated or deleted; corrections are compensating rows.
model MxXpTransaction {
  id              String     @id @default(cuid())
  userId          String
  user            MxUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType      String // task | non_negotiable | habit | focus | goal | milestone | journal | gratitude | review | reversal | …
  sourceId        String?
  reason          String
  evidence        MxEvidence @default(SELF_REPORTED)
  multiplier      Float      @default(1)
  mainDelta       Int // MAINXP change (may be negative on reversal)
  coinsDelta      Int        @default(0) // spendable Coins (rewards economy) — same ledger, same auditability
  attributeDeltas Json       @default("{}") // { "FOCUS": 15, … }
  idempotencyKey  String?    @unique // "<sourceType>:<sourceId>:<event>" — blocks duplicates
  reversesId      String?    @unique // id of the transaction this row compensates
  createdAt       DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([userId, sourceType])
  @@map("mainxp_xp_transactions")
}

model MxGearOwned {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gearId    String // catalog id from src/lib/mainxp/gear.ts
  equipped  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, gearId])
  @@map("mainxp_gear_owned")
}

model MxReward {
  id            String   @id @default(cuid())
  userId        String
  user          MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  costCoins     Int
  redeemedCount Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([userId, active])
  @@map("mainxp_rewards")
}

model MxJournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("free") // free|morning|night|decision|business|relationship|victory|lesson|comeback
  mood      String   @default("") // how it feels right now: bien|moyen|dur|a_fond|epuise
  content   String
  dayKey    String
  createdAt DateTime @default(now())

  @@index([userId, dayKey])
  @@map("mainxp_journal_entries")
}

model MxGratitudeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey      String
  /** morning | night | free (coach tool). Both rituals store; XP pays once/day. */
  period      String   @default("free")
  /** 0–9 — the 01–10 ritual keeps the user's own order. */
  position    Int      @default(0)
  content     String
  whyItMatter String   @default("")
  thankWho    String   @default("")
  /** Added later, when re-reading: what this still does to you. */
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, dayKey, period, position])
  @@index([userId, dayKey])
  @@map("mainxp_gratitude_entries")
}

model MxMemory {
  id                 String    @id @default(cuid())
  userId             String
  user               MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String // identity|preference|goal|commitment|person|project|decision|lesson|event|pattern|financial_context|health_context|journal_insight
  content            String
  importance         Int       @default(3) // 1-5
  confidence         Float     @default(0.8)
  source             String    @default("user_stated") // user_stated | ai_inferred | onboarding
  sensitivity        String    @default("normal") // normal | private
  scope              String    @default("long_term") // permanent | long_term | temporary | immediate
  expiresAt          DateTime? // temporary/immediate memories expire out of coach context
  doNotUseInCoaching Boolean   @default(false)
  embeddingRef       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastAccessedAt     DateTime?

  @@index([userId, type])
  @@map("mainxp_memories")
}

model MxConversation {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MxMessage[]

  @@index([userId, updatedAt])
  @@map("mainxp_conversations")
}

model MxMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   MxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | tool
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("mainxp_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// LE CERCLE — accountability partners.
//
// Design law (docs/PRIVACY_SECURITY.md): sharing is per-direction and every
// switch defaults to false. A link between two people is TWO rows — mine says
// what I show you, yours says what you show me — so revoking is local and
// instant, and no query can ever "inherit" the other side's generosity.
//
// Money, journal, gratitude, notes, memories and coach conversations have no
// switch at all: they are not shareable by construction, not by configuration.
// ─────────────────────────────────────────────────────────────────────────────

// A share link the inviter sends by message. It carries no personal data — it
// is only a claimable token, and accepting it is an explicit POST.
model MxCircleInvite {
  id           String    @id @default(cuid())
  inviterId    String
  inviter      MxUser    @relation("MxInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  token        String    @unique
  label        String    @default("") // the inviter's own words: « pour Marc »
  acceptedById String?
  acceptedBy   MxUser?   @relation("MxInvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([inviterId, createdAt])
  @@map("mainxp_circle_invites")
}

// One row per direction. `userId` is the person SHARING; `partnerId` is who
// they share with.
model MxCircleLink {
  id        String @id @default(cuid())
  userId    String
  user      MxUser @relation("MxCircleOwner", fields: [userId], references: [id], onDelete: Cascade)
  partnerId String
  partner   MxUser @relation("MxCirclePartner", fields: [partnerId], references: [id], onDelete: Cascade)

  status String @default("active") // active | paused | ended

  // The four switches. All false: a fresh partner sees a name and nothing else.
  shareElan       Boolean @default(false) // streak + keep rate
  shareMainQuest  Boolean @default(false) // today's headline, done or not
  shareChallenges Boolean @default(false) // only the ones in the allowlist
  shareWeekly     Boolean @default(false) // the week's shape, never the ledger

  // Allowlists: sharing a category never means sharing everything in it.
  goalIds      String[] @default([])
  challengeIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, partnerId])
  @@index([partnerId, status])
  @@map("mainxp_circle_links")
}

// A block is absolute and mutual in effect: it hides both directions and
// survives re-invitation.
model MxBlock {
  id        String   @id @default(cuid())
  userId    String
  user      MxUser   @relation("MxBlocksMade", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   MxUser   @relation("MxBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
  @@map("mainxp_blocks")
}

// « Je te soutiens » — the only social action. No likes, no comments, no feed:
// support is sent to a person, not performed for an audience.
model MxEncouragement {
  id        String   @id @default(cuid())
  fromId    String
  from      MxUser   @relation("MxSupportSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        MxUser   @relation("MxSupportReceived", fields: [toId], references: [id], onDelete: Cascade)
  kind      String   @default("support") // support | proud | push
  dayKey    String
  seenAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([fromId, toId, dayKey, kind]) // one of each per day: care, not spam
  @@index([toId, createdAt])
  @@map("mainxp_encouragements")
}

// Password recovery. The token itself is never stored — only its SHA-256 — so
// a database leak cannot be used to take over accounts. Single use, short
// lived, and using one logs every other device out.
model MxPasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      MxUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("mainxp_password_resets")
}
