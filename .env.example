# ── MAINXP — environment variables ──
# Copy to ".env" and fill in. Never commit ".env".

# PostgreSQL connection strings (local dev example shown).
# On Neon: DATABASE_URL = the POOLED string (host contains -pooler),
# DIRECT_DATABASE_URL = the DIRECT string (no -pooler) — used for migrations.
DATABASE_URL="postgresql://user@localhost:5432/mainxp_development"
DIRECT_DATABASE_URL="postgresql://user@localhost:5432/mainxp_development"

# ── AI (optional — coach features stay honestly offline without it) ──
# Server-side only. Never expose in client code. Set ONE of the two:
# Gemini: AI Studio key ("AIza…") or Vertex Express key ("AQ.…")
MAINXP_GEMINI_API_KEY=""
# Anthropic (takes precedence when both are set)
MAINXP_ANTHROPIC_API_KEY=""
# Optional model override (e.g. gemini-2.5-flash / claude-sonnet-5).
MAINXP_AI_MODEL=""

# ── Scheduled jobs (Phase 1+) — shared secret guarding /api/jobs/* ──
MAINXP_JOBS_SECRET=""
