# ── MAINXP — environment variables ──
# Copy to ".env" and fill in. Never commit ".env".

# PostgreSQL connection string (local dev example shown).
DATABASE_URL="postgresql://user@localhost:5432/mainxp_development"

# ── AI (optional — coach features stay honestly offline without it) ──
# Server-side only. Never expose in client code.
MAINXP_ANTHROPIC_API_KEY=""
# Optional model override for coach conversations.
MAINXP_AI_MODEL=""

# ── Scheduled jobs (Phase 1+) — shared secret guarding /api/jobs/* ──
MAINXP_JOBS_SECRET=""
